# Google Sheet con el catálogo (por defecto el de Sur IPhone)
GOOGLE_SHEET_ID=1VVLezC-1LWBEyK9j3MJ96sA5TuPftbOeTK0Va1vqk4U
# Opcional: API key de Google Sheets API v4. Sin key se usa el export CSV público de la hoja.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_RANGE=A1:Z200
GOOGLE_SHEET_GID=0

# Conversión a USD cuando la hoja no tiene columna "Precio USD".
# Si USD_ARS_RATE está vacío se usa la cotización de dolarapi.com (USD_RATE_SOURCE: blue | oficial | bolsa | tarjeta).
USD_ARS_RATE=
USD_RATE_SOURCE=blue

# Opcional: varias pestañas/rangos separados por coma (ej: "iPhones!A1:Z200,Accesorios!A1:Z200")
# o una URL CSV directa (Archivo → Compartir → Publicar en la web → CSV).
CATALOG_CSV_URL=

# Datos bancarios para "Pago por Transferencia / Depósito Bancario".
# Si BANK_CBU y BANK_ALIAS están vacíos, el checkout ofrece pedirlos por WhatsApp.
BANK_CBU=
BANK_ALIAS=
BANK_HOLDER=
BANK_NAME=
BANK_CUIT=
